{%- from "tree_link.jinja" import tree_link -%}
{%- if agents | length > 0 -%}
  {%- call Flex(shrink=0) -%}
  {{- " Agents " | bold | bg("index:6") | fg("index:0") -}}
  {%- endcall -%}
  {%- set spinner_frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"] -%}
  {%- macro spinner(fps=8) -%}{{ spinner_frames[AnimationFrame(fps=fps) % (spinner_frames | length)] }}{%- endmacro -%}
  {%- macro t(text, focused) -%}{{ text | bold if focused else text | dim }}{%- endmacro -%}

  {%- for tab in tabs -%}
  {%- if tab.agents | length > 0 -%}

    {%- set tab_label = " %s " | format(tab.tab_name) -%}
    {%- if tab.tab_id is not none -%}
      {%- call Button(on_click=actions.switch_tab(tab.tab_id), focused=false) -%}
      {{- tab_label | bg("index:6") | fg("index:0") if tab.active else tab_label | bg("index:8") | dim -}}
      {%- endcall -%}
    {%- else -%}
      {%- call Flex(shrink=0) -%}
      {{- tab_label | bg("index:6") | fg("index:0") if tab.active else tab_label | bg("index:8") | dim -}}
      {%- endcall -%}
    {%- endif -%}

    {%- for agent in tab.agents -%}
      {%- set icon = spinner() if agent.state == "running" else "󰏧" -%}
      {%- set agent_label = "%s %s %s" | format(agent.pane, icon, agent.title) -%}
      {%- call Button(on_click=actions.focus_pane(agent.pane), focused=agent.focused) -%}
        {{ " " }} {{ tree_link(loop.index0, tab.agents | length) | dim }} {{ icon }} {{ t(agent_label, agent.focused) }}
        {%- if agent.state == "running" and agent.current_tool %}
          {{ "┃" | bold if agent.focused else "┃" | dim }}  {{ agent.current_tool | bold if agent.focused else agent.current_tool | dim }}
        {%- endif -%}
      {%- endcall -%}
    {%- endfor -%}

  {%- endif -%}
  {%- endfor -%}

  {%- if orphans | length > 0 -%}
    {%- call Flex(shrink=0) -%}
    {{- " Orphans " | bg("index:8") | dim -}}
    {%- endcall -%}

    {%- for agent in orphans -%}
      {%- set icon = spinner() if agent.state == "running" else "󰏧" -%}
      {%- set agent_label = "%s %s %s" | format(agent.pane, icon, agent.title) -%}
      {%- call Button(on_click=actions.focus_pane(agent.pane), focused=agent.focused) -%}
        {{ " " }} {{ tree_link(loop.index0, orphans | length) | dim }} {{ icon }} {{ t(agent_label, agent.focused) }}
        {%- if agent.state == "running" and agent.current_tool %}
          {{ "┃" | bold if agent.focused else "┃" | dim }}  {{ agent.current_tool | bold if agent.focused else agent.current_tool | dim }}
        {%- endif -%}
      {%- endcall -%}
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}
