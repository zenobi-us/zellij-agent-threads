{% import "tree.jinja" as tree %}
{% import "agent.jinja" as agent_view %}
{%- if agents | length > 0 -%}
  {%- call Flex(shrink=0) -%}{{- " Agents " | bold -}}{%- endcall -%}

  {%- for tab in tabs if tab.agents | length > 0 -%}
    {%- set tab_index = loop.index0 -%}
    {%- set tab_total = loop.length -%}
    {%- set tab_is_last = loop.last -%}
    {%- set tab_label = " %s " | format(tab.tab_name) -%}
    {%- if tab.tab_id is not none -%}
      {%- call Button(on_click=actions.switch_tab(tab.tab_id), focused=false) -%}{{- tree.prefix_line(tab_index, tab_total) | dim }}{{- tab_label | bg("index:6") | fg("index:0") if tab.active else tab_label | bg("index:8") | dim -}}{%- endcall -%}
    {%- else -%}
      {%- call Flex(shrink=0) -%}{{- tree.prefix_line(tab_index, tab_total) | dim }}{{- tab_label | bg("index:6") | fg("index:0") if tab.active else tab_label | bg("index:8") | dim -}}{%- endcall -%}
    {%- endif -%}

    {%- for agent in tab.agents -%}
      {%- set agent_is_last = loop.last -%}
      {%- call Button(on_click=actions.focus_pane(agent.pane), focused=agent.focused) -%}{{ agent_view.button_body(agent, loop.index0, loop.length, tab_is_last, agent_is_last) }}{%- endcall -%}
    {%- endfor -%}
  {%- endfor -%}

{%- endif -%}
