{%- if sessions | length > 0 -%}
  {%- call Flex(shrink=0) -%}
  {{- " Sessions " | bold | bg("index:3") | fg("index:0") -}}
  {%- endcall -%}

  {%- for session in sessions -%}
    {%- set agent_suffix = " %sa" | format(session.agent_count) if session.agent_count > 0 else "" -%}
    {%- set session_label = " %s%s " | format(session.name, agent_suffix) -%}
    {%- if session.current -%}
      {%- call Flex(shrink=0) -%}
      {{- session_label | bold | bg("index:3") | fg("index:0") -}}
      {%- endcall -%}
    {%- else -%}
      {%- call Button(on_click=actions.switch_to_session(session.name), focused=false) -%}
      {{- session_label | bg("index:8") | dim -}}
      {%- endcall -%}
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- include "session_badge.jinja" -%}
{%- endif -%}
