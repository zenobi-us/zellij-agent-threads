"tags\":[],\"type\":\"text\",\"url\":\"/how-it-works#closed-pane-filtering\",\"content\":\"The plugin compares snapshot rows with live Zellij panes. If a row has a pane ID that no longer exists, the plugin ignores that row.\"}],[\"/how-it-works-32\",{\"id\":\"/how-it-works-32\",\"page_id\":\"/how-it-works\",\"tags\":[],\"type\":\"text\",\"url\":\"/how-it-works#result\",\"content\":\"A normal update uses this path:\"}],[\"/how-it-works-33\",{\"id\":\"/how-it-works-33\",\"page_id\":\"/how-it-works\",\"tags\":[],\"type\":\"text\",\"url\":\"/how-it-works#result\",\"content\":\"The store cleans old rows. The plugin also protects the panel from stale rows. No background sweeper is required.\"}],[\"/quickstart\",{\"id\":\"/quickstart\",\"page_id\":\"/quickstart\",\"type\":\"page\",\"content\":\"Quickstart\",\"breadcrumbs\":[\"Docs\"],\"tags\":[],\"url\":\"/quickstart\"}],[\"/quickstart-0\",{\"id\":\"/quickstart-0\",\"page_id\":\"/quickstart\",\"tags\":[],\"type\":\"text\",\"url\":\"/quickstart\",\"content\":\"Create a workspace, write a manifest, and run Boxfiles.\"}],[\"/quickstart-1\",{\"id\":\"/quickstart-1\",\"page_id\":\"/quickstart\",\"type\":\"heading\",\"tags\":[],\"url\":\"/quickstart#user-quickstart\",\"content\":\"User quickstart\"}],[\"/quickstart-2\",{\"id\":\"/quickstart-2\",\"page_id\":\"/quickstart\",\"type\":\"heading\",\"tags\":[],\"url\":\"/quickstart#goal\",\"content\":\"Goal\"}],[\"/quickstart-3\",{\"id\":\"/quickstart-3\",\"page_id\":\"/quickstart\",\"type\":\"heading\",\"tags\":[],\"url\":\"/quickstart#1-create-a-workspace\",\"content\":\"1\\\\. Create a workspace\"}],[\"/quickstart-4\",{\"id\":\"/quickstart-4\",\"page_id\":\"/quickstart\",\"type\":\"heading\",\"tags\":[],\"url\":\"/quickstart#2-create-a-manifest\",\"content\":\"2\\\\. Create a manifest\"}],[\"/quickstart-5\",{\"id\":\"/quickstart-5\",\"page_id\":\"/quickstart\",\"type\":\"heading\",\"tags\":[],\"url\":\"/quickstart#3-inspect-discovered-manifests\",\"content\":\"3\\\\. Inspect discov